{
  "AllowedHosts": "*",
  "DetailedErrors": false,
  "Kestrel": {
    "AddServerHeader": false
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "Authority": ""
  },
  "Cors": {
    "AllowedOrigins": [ "https://www.skieshop.com" ]
  },
  "Kafka": {
    "BootstrapServers": "",
    "GroupId": "api-gateway"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "SkiShop": "Information",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/api/v1/auth/login",
          "Methods": ["POST"]
        },
        "Order": 1
      },
      "auth-register-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/api/v1/auth/users",
          "Methods": ["POST"]
        },
        "Order": 2
      },
      "auth-password-reset-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "login",
        "Match": {
          "Path": "/api/v1/auth/password/reset",
          "Methods": ["POST"]
        },
        "Order": 3
      },
      "auth-email-verify-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "anonymous-api",
        "Match": {
          "Path": "/api/v1/auth/email/verify",
          "Methods": ["POST"]
        },
        "Order": 4
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "user-based",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Order": 10
      },
      "users-me-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "user-based",
        "Match": {
          "Path": "/api/v1/users/me"
        },
        "Order": 1
      },
      "users-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "user-based",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        },
        "Order": 10
      },
      "admin-users-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "AdminOrManager",
        "RateLimiterPolicy": "user-based",
        "Match": {
          "Path": "/api/v1/admin/users/{**catch-all}"
        }
      },
      "products-search-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "products",
        "Match": {
          "Path": "/api/products/search"
        },
        "Order": 1
      },
      "products-sku-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "products",
        "Match": {
          "Path": "/api/products/sku/{sku}"
        },
        "Order": 2
      },
      "products-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "products",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "Order": 10
      },
      "categories-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "Anonymous",
        "RateLimiterPolicy": "products",
