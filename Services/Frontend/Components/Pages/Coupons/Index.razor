@page "/coupons"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject ICouponApiClient CouponApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<Index> Logger

<PageTitle>クーポン - Azure SkiShop</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <MudText Typo="Typo.h4" Class="mb-6" Style="font-weight: 700;">
        <MudIcon Icon="@Icons.Material.Filled.ConfirmationNumber" Class="mr-2" /> クーポン
    </MudText>

    <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="2" Rounded="true" ApplyEffectsToContainer="true"
             Class="mb-6" PanelClass="pa-4">
        <MudTabPanel Text="利用可能なクーポン" Icon="@Icons.Material.Filled.CardGiftcard">
            @if (_isLoadingAvailable)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
            }
            else if (_availableCoupons.Count == 0)
            {
                <MudPaper Elevation="0" Class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large"
                             Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" Class="mb-2">利用可能なクーポンがありません</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary">
                        新しいクーポンが公開されると、ここに表示されます。
                    </MudText>
                </MudPaper>
            }
            else
            {
                <MudGrid>
                    @foreach (var coupon in _availableCoupons)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="2" Style="border-radius: 12px; height: 100%;">
                                <MudCardContent>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small"
                                                 Variant="Variant.Filled">
                                            @coupon.Code
                                        </MudChip>
                                        <MudChip T="string" Color="@GetDiscountColor(coupon.DiscountType)"
                                                 Size="Size.Small" Variant="Variant.Outlined">
                                            @FormatDiscount(coupon)
                                        </MudChip>
                                    </MudStack>

                                    <MudText Typo="Typo.body1" Class="mt-3 mb-2">@coupon.Description</MudText>

                                    @if (coupon.MinimumOrderAmount.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small"
                                                     Class="mr-1" />
                                            最低注文金額: ¥@coupon.MinimumOrderAmount.Value.ToString("N0")
                                        </MudText>
                                    }

                                    @if (coupon.ExpiresAt.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small"
                                                     Class="mr-1" />
                                            有効期限: @coupon.ExpiresAt.Value.ToString("yyyy/MM/dd")
                                        </MudText>
                                    }
                                </MudCardContent>
                                <MudCardActions>
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               FullWidth="true"
                                               OnClick="@(() => AcquireCouponAsync(coupon))"
                                               Disabled="_isAcquiring"
                                               StartIcon="@Icons.Material.Filled.Add">
                                        取得する
                                    </MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudTabPanel>

        <MudTabPanel Text="マイクーポン" Icon="@Icons.Material.Filled.Wallet">
            @if (_isLoadingMy)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
            }
            else if (_myCoupons.Count == 0)
            {
                <MudPaper Elevation="0" Class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large"
                             Color="Color.Default" Class="mb-4" />
                    <MudText Typo="Typo.h6" Class="mb-2">取得済みクーポンがありません</MudText>
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                        「利用可能なクーポン」タブからクーポンを取得してください。
                    </MudText>
                </MudPaper>
            }
            else
            {
                <MudGrid>
                    @foreach (var coupon in _myCoupons)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Elevation="2"
                                     Style="@($"border-radius: 12px; height: 100%; {(coupon.IsUsed ? "opacity: 0.6;" : "")}")">
                                <MudCardContent>
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small"
                                                 Variant="Variant.Filled">
                                            @coupon.Code
                                        </MudChip>
                                        @if (coupon.IsUsed)
                                        {
                                            <MudChip T="string" Color="Color.Default" Size="Size.Small"
                                                     Variant="Variant.Filled">
                                                使用済み
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="@GetDiscountColor(coupon.DiscountType)"
                                                     Size="Size.Small" Variant="Variant.Outlined">
                                                @FormatDiscount(coupon)
                                            </MudChip>
                                        }
                                    </MudStack>

                                    <MudText Typo="Typo.body1" Class="mt-3 mb-2">@coupon.Description</MudText>

                                    @if (coupon.MinimumOrderAmount.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small"
                                                     Class="mr-1" />
                                            最低注文金額: ¥@coupon.MinimumOrderAmount.Value.ToString("N0")
                                        </MudText>
                                    }

                                    @if (coupon.ExpiresAt.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small"
                                                     Class="mr-1" />
                                            有効期限: @coupon.ExpiresAt.Value.ToString("yyyy/MM/dd")
                                        </MudText>
                                    }
                                </MudCardContent>
                                @if (!coupon.IsUsed)
                                {
                                    <MudCardActions>
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   FullWidth="true"
                                                   Href="/cart"
                                                   StartIcon="@Icons.Material.Filled.ShoppingCart">
                                            カートで使う
                                        </MudButton>
                                    </MudCardActions>
                                }
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private int _activeTab;
    private List<CouponDto> _availableCoupons = [];
    private List<CouponDto> _myCoupons = [];
    private bool _isLoadingAvailable = true;
    private bool _isLoadingMy = true;
    private bool _isAcquiring;

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("ホーム", href: "/"),
        new("クーポン", href: null, disabled: true)
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var availableTask = CouponApi.GetAvailableCouponsAsync();
            var myTask = CouponApi.GetMyCouponsAsync();

            await Task.WhenAll(availableTask, myTask);

            _availableCoupons = await availableTask;
            _myCoupons = await myTask;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "クーポン情報の取得に失敗しました");
            Snackbar.Add("クーポン情報の読み込みに失敗しました", Severity.Error);
        }
        finally
        {
            _isLoadingAvailable = false;
            _isLoadingMy = false;
        }
    }

    private async Task AcquireCouponAsync(CouponDto coupon)
    {
        _isAcquiring = true;
        StateHasChanged();

        try
        {
            var acquired = await CouponApi.AcquireCouponAsync(coupon.Id);
            if (acquired is not null)
            {
                _availableCoupons.Remove(coupon);
                _myCoupons.Add(acquired);
                Snackbar.Add("クーポンを取得しました", Severity.Success);
                _activeTab = 1;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "クーポンの取得に失敗しました: CouponId={CouponId}", coupon.Id);
            Snackbar.Add("クーポンの取得に失敗しました", Severity.Error);
        }
        finally
        {
            _isAcquiring = false;
            StateHasChanged();
        }
    }

    private static string FormatDiscount(CouponDto coupon) => coupon.DiscountType switch
    {
        "PERCENTAGE" or "percentage" => $"{coupon.DiscountValue}% OFF",
        "FIXED" or "fixed" => $"¥{coupon.DiscountValue:N0} OFF",
        _ => $"{coupon.DiscountValue}"
    };

    private static Color GetDiscountColor(string discountType) => discountType switch
    {
        "PERCENTAGE" or "percentage" => Color.Warning,
        "FIXED" or "fixed" => Color.Success,
        _ => Color.Info
    };
}
