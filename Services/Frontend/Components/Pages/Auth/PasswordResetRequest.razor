@page "/auth/password-reset-request"
@rendermode @(RenderMode.InteractiveServer)
@inject IAuthApiClient AuthApi
@inject NavigationManager Navigation

<PageTitle>パスワードリセット — Azure SkiShop</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Elevation="4" Class="pa-8 rounded-lg">
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h4" Class="mt-2" Style="font-weight: 700; color: #1565C0;">
                パスワードリセット
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                登録済みのメールアドレスを入力してください
            </MudText>
        </div>

        @if (!_submitted)
        {
            <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync" FormName="PasswordResetRequestForm">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_model.Email"
                              Label="メールアドレス"
                              InputType="InputType.Email"
                              Required="true"
                              RequiredError="メールアドレスは必須です"
                              Variant="Variant.Outlined"
                              Class="mb-4"
                              autocomplete="email" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@_isLoading"
                           Style="min-height: 48px;">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    リセットメールを送信
                </MudButton>
            </EditForm>
        }
        else
        {
            <MudAlert Severity="Severity.Success" Class="mb-4" role="status">
                パスワードリセット用のメールを送信しました。メール内のリンクからパスワードを再設定してください。
            </MudAlert>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                メールが届かない場合は、迷惑メールフォルダをご確認ください。
            </MudText>
        }

        <div class="text-center mt-4">
            <MudLink Href="/auth/login" Typo="Typo.body2">ログイン画面に戻る</MudLink>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private readonly ResetRequestModel _model = new();
    private bool _isLoading;
    private bool _submitted;

    private async Task HandleSubmitAsync()
    {
        _isLoading = true;

        try
        {
            await AuthApi.RequestPasswordResetAsync(_model.Email);
        }
        catch
        {
            // セキュリティ: 存在しないメールでも同じレスポンスを返す
        }
        finally
        {
            _submitted = true;
            _isLoading = false;
        }
    }

    private sealed class ResetRequestModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "メールアドレスは必須です")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "有効なメールアドレスを入力してください")]
        public string Email { get; set; } = string.Empty;
    }
}
