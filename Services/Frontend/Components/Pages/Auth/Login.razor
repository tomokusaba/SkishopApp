@page "/auth/login"
@rendermode @(RenderMode.InteractiveServer)
@using Fluxor
@using Frontend.Services
@inject IAuthApiClient AuthApi
@inject ITokenStorageService TokenStorage
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDispatcher Dispatcher
@inject ILogger<Login> Logger

<PageTitle>ログイン — Azure SkiShop</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Elevation="4" Class="pa-8 rounded-lg">
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.AcUnit" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h4" Class="mt-2" Style="font-weight: 700; color: #1565C0;">ログイン</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Azure SkiShop へようこそ</MudText>
        </div>

        @if (!_mfaRequired)
        {
            <EditForm Model="_loginModel" OnValidSubmit="HandleLoginAsync" FormName="LoginForm">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_errorMessage</MudAlert>
                }

                <MudTextField @bind-Value="_loginModel.Email"
                              Label="メールアドレス"
                              InputType="InputType.Email"
                              Required="true"
                              RequiredError="メールアドレスは必須です"
                              Variant="Variant.Outlined"
                              Class="mb-4"
                              autocomplete="email" />

                <MudTextField @bind-Value="_loginModel.Password"
                              Label="パスワード"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Required="true"
                              RequiredError="パスワードは必須です"
                              Variant="Variant.Outlined"
                              Class="mb-2"
                              autocomplete="current-password"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="() => _showPassword = !_showPassword" />

                <div class="d-flex justify-end mb-4">
                    <MudLink Href="/auth/password-reset-request" Typo="Typo.body2">パスワードを忘れた場合</MudLink>
                </div>

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@_isLoading"
                           Class="mb-4"
                           Style="min-height: 48px;">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    ログイン
                </MudButton>

                <MudDivider Class="my-4" />

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Login"
                           Href="/auth/oauth/microsoft"
                           Class="mb-4"
                           Style="min-height: 44px;">
                    Microsoft アカウントでログイン
                </MudButton>

                <div class="text-center">
                    <MudText Typo="Typo.body2">
                        アカウントをお持ちでない方は
                        <MudLink Href="/auth/register">新規登録</MudLink>
                    </MudText>
                </div>
            </EditForm>
        }
        else
        {
            <MudText Typo="Typo.h6" Class="mb-4">二段階認証</MudText>
            <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
                認証アプリに表示されている 6 桁のコードを入力してください
            </MudText>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_errorMessage</MudAlert>
            }

            @if (_isLocked)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4" role="alert">
                    試行回数の上限に達しました。15 分間お待ちください。
                </MudAlert>
            }
            else
            {
                @if (!_useBackupCode)
                {
                    <MudTextField @bind-Value="_mfaCode"
                                  Label="認証コード（6桁）"
                                  MaxLength="6"
                                  Variant="Variant.Outlined"
                                  Class="mb-4"
                                  autocomplete="one-time-code" />
                }
                else
                {
                    <MudTextField @bind-Value="_mfaCode"
                                  Label="バックアップコード"
                                  Variant="Variant.Outlined"
                                  Class="mb-4" />
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           OnClick="HandleMfaVerifyAsync"
                           Disabled="@(_isLoading || _isLocked)"
                           Style="min-height: 48px;">
                    認証する
                </MudButton>

                <div class="text-center mt-3">
                    <MudLink OnClick="() => _useBackupCode = !_useBackupCode">
                        @(_useBackupCode ? "認証コードを使う" : "バックアップコードを使う")
                    </MudLink>
                </div>
            }
        }
    </MudPaper>
</MudContainer>

@code {
    private readonly LoginModel _loginModel = new();
    private bool _showPassword;
    private bool _isLoading;
    private string? _errorMessage;
    private bool _mfaRequired;
    private string? _sessionToken;
    private string _mfaCode = string.Empty;
    private bool _useBackupCode;
    private int _mfaAttempts;
    private bool _isLocked;

    private async Task HandleLoginAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthApi.LoginAsync(_loginModel.Email, _loginModel.Password);

            if (response.MfaRequired)
            {
                _mfaRequired = true;
                _sessionToken = response.SessionToken;
            }
            else
            {
                await CompleteLoginAsync(response.AccessToken, response.RefreshToken, response.ExpiresIn, response.User);
            }
        }
        catch (UnauthorizedAccessException)
        {
            _errorMessage = "メールアドレスまたはパスワードが正しくありません";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ログイン処理中に予期しないエラーが発生: {Message}", ex.Message);
            _errorMessage = "サーバーエラーが発生しました。しばらく経ってからお試しください";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleMfaVerifyAsync()
    {
        if (string.IsNullOrWhiteSpace(_mfaCode) || _sessionToken is null) return;

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await AuthApi.VerifyMfaAsync(_sessionToken, _mfaCode);
            await CompleteLoginAsync(response.AccessToken, response.RefreshToken, response.ExpiresIn, response.User);
        }
        catch (UnauthorizedAccessException)
        {
            _mfaAttempts++;
            if (_mfaAttempts >= 5)
            {
                _isLocked = true;
                _errorMessage = "試行回数の上限に達しました。15 分間お待ちください";
            }
            else
            {
                _errorMessage = "認証コードが正しくありません";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "MFA検証中に予期しないエラーが発生: {Message}", ex.Message);
            _errorMessage = "サーバーエラーが発生しました";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task CompleteLoginAsync(string accessToken, string refreshToken, int expiresIn, LoginUserInfo user)
    {
        TokenStorage.StoreTokens(accessToken, refreshToken, expiresIn);
        Dispatcher.Dispatch(new Frontend.Store.AuthStore.LoginSuccessAction(
            user.Id, $"{user.FirstName} {user.LastName}", string.Empty, user.Role));

        await AuthApi.MergeCartAsync();

        Navigation.NavigateTo("/", forceLoad: true);
    }

    private sealed class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
