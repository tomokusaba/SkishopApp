@page "/auth/password-reset"
@rendermode @(RenderMode.InteractiveServer)
@inject IAuthApiClient AuthApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>パスワード再設定 — Azure SkiShop</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudPaper Elevation="4" Class="pa-8 rounded-lg">
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.VpnKey" Color="Color.Primary" Size="Size.Large" />
            <MudText Typo="Typo.h4" Class="mt-2" Style="font-weight: 700; color: #1565C0;">
                新しいパスワードを設定
            </MudText>
        </div>

        @if (!_completed)
        {
            <EditForm Model="_model" OnValidSubmit="HandleResetAsync" FormName="PasswordResetForm">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_errorMessage</MudAlert>
                }

                <MudTextField @bind-Value="_model.NewPassword"
                              Label="新しいパスワード"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Required="true"
                              RequiredError="パスワードは必須です"
                              Variant="Variant.Outlined"
                              Class="mb-4"
                              autocomplete="new-password"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="() => _showPassword = !_showPassword"
                              HelperText="8 文字以上、大文字・小文字・数字・記号を含む" />

                <MudTextField @bind-Value="_model.ConfirmPassword"
                              Label="パスワード確認"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="パスワード確認は必須です"
                              Variant="Variant.Outlined"
                              Class="mb-4"
                              autocomplete="new-password" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="@_isLoading"
                           Style="min-height: 48px;">
                    @if (_isLoading)
                    {
                        <MudProgressCircular Color="Color.Inherit" Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    パスワードを再設定
                </MudButton>
            </EditForm>
        }
        else
        {
            <MudAlert Severity="Severity.Success" Class="mb-4" role="status">
                パスワードが正常に再設定されました。
            </MudAlert>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Href="/auth/login"
                       Style="min-height: 48px;">
                ログイン画面へ
            </MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    private readonly ResetModel _model = new();
    private bool _showPassword;
    private bool _isLoading;
    private bool _completed;
    private string? _errorMessage;

    private async Task HandleResetAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            _errorMessage = "リセットリンクが無効です";
            return;
        }

        if (_model.NewPassword != _model.ConfirmPassword)
        {
            _errorMessage = "パスワードが一致しません";
            return;
        }

        _isLoading = true;
        _errorMessage = null;

        try
        {
            await AuthApi.ResetPasswordAsync(Token, _model.NewPassword);
            _completed = true;
            Snackbar.Add("パスワードが再設定されました", Severity.Success);
        }
        catch (Exception)
        {
            _errorMessage = "パスワードの再設定に失敗しました。リンクが期限切れの可能性があります";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private sealed class ResetModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "パスワードは必須です")]
        [System.ComponentModel.DataAnnotations.StringLength(100, MinimumLength = 8, ErrorMessage = "パスワードは 8 文字以上で入力してください")]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "パスワード確認は必須です")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
