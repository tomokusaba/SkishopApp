@page "/legal/privacy"

<PageTitle>プライバシーポリシー - Azure SkiShop</PageTitle>

<HeadContent>
    <meta name="description" content="Azure SkiShop のプライバシーポリシーです。お客様の個人情報の取り扱いについてご説明します。" />
</HeadContent>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudBreadcrumbs Items="_breadcrumbs" Class="mb-4" />

    <MudPaper Elevation="2" Class="pa-6" Style="border-radius: 12px;">
        <MudText Typo="Typo.h4" Class="mb-6" Style="font-weight: 700;">プライバシーポリシー</MudText>

        <MudText Typo="Typo.body1" Class="mb-4" Style="line-height: 1.8; color: #424242;">
            株式会社 Azure SkiShop（以下「当社」）は、お客様の個人情報の保護を重要な責務と認識し、以下のプライバシーポリシーに基づき適切に管理・運用いたします。
        </MudText>

        <MudText Typo="Typo.h6" Class="mt-6 mb-3" Style="font-weight: 600;">1. 収集する情報</MudText>
        <MudText Typo="Typo.body1" Class="mb-4" Style="line-height: 1.8; color: #424242;">
            当社は、サービスの提供に必要な範囲で、以下の情報を収集します。
        </MudText>
        <MudList T="string" Dense="true" Class="mb-4">
            <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight">氏名、メールアドレス、電話番号</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight">配送先住所</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight">ご購入履歴、閲覧履歴</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight">Cookie およびアクセスログ</MudListItem>
        </MudList>

        <MudText Typo="Typo.h6" Class="mt-6 mb-3" Style="font-weight: 600;">2. 利用目的</MudText>
        <MudList T="string" Dense="true" Class="mb-4">
            <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight">商品の販売および配送</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight">ご注文の確認・お問い合わせへの対応</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight">サービスの改善・新サービスの開発</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight">AI による商品レコメンデーション</MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.ChevronRight">マーケティング（お客様の同意がある場合のみ）</MudListItem>
        </MudList>

        <MudText Typo="Typo.h6" Class="mt-6 mb-3" Style="font-weight: 600;">3. 第三者への提供</MudText>
        <MudText Typo="Typo.body1" Class="mb-4" Style="line-height: 1.8; color: #424242;">
            当社は、法令に基づく場合を除き、お客様の同意なく個人情報を第三者に提供することはありません。ただし、配送業者および決済サービス提供者には、サービス提供に必要な範囲で情報を共有します。
        </MudText>

        <MudText Typo="Typo.h6" Class="mt-6 mb-3" Style="font-weight: 600;">4. セキュリティ</MudText>
        <MudText Typo="Typo.body1" Class="mb-4" Style="line-height: 1.8; color: #424242;">
            当社は、個人情報の漏洩・滅失・改ざんを防止するため、SSL/TLS による通信の暗号化、アクセス制御、および適切なセキュリティ対策を講じています。
        </MudText>

        <MudText Typo="Typo.h6" Class="mt-6 mb-3" Style="font-weight: 600;">5. Cookie の使用</MudText>
        <MudText Typo="Typo.body1" Class="mb-4" Style="line-height: 1.8; color: #424242;">
            当社は、サービスの利便性向上のために Cookie を使用します。お客様はブラウザの設定により Cookie の受け入れを拒否できますが、一部サービスが正常に動作しない場合があります。
        </MudText>

        <MudText Typo="Typo.h6" Class="mt-6 mb-3" Style="font-weight: 600;">6. お問い合わせ</MudText>
        <MudText Typo="Typo.body1" Style="line-height: 1.8; color: #424242;">
            個人情報の取り扱いに関するお問い合わせは、support&#64;azure-skishop.example.com までご連絡ください。
        </MudText>

        <MudText Typo="Typo.caption" Class="mt-6" Style="color: #999;">最終更新日: 2026 年 1 月 1 日</MudText>
    </MudPaper>
</MudContainer>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("ホーム", href: "/"),
        new("プライバシーポリシー", href: null, disabled: true)
    ];
}
