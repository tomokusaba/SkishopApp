@page "/checkout/payment"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject ICartApiClient CartApi
@inject IPointApiClient PointApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ILogger<Payment> Logger

<PageTitle>お支払い - チェックアウト - Azure SkiShop</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <Frontend.Components.Shared.StepIndicator CurrentStep="3" />

    <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 700;">お支払い</MudText>

    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_cart is not null)
    {
        <MudGrid>
            <MudItem xs="12" md="8">
                @* Payment method *@
                <MudPaper Elevation="2" Class="pa-6 mb-4" Style="border-radius: 12px;">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 600;">お支払い方法</MudText>
                    <MudAlert Severity="Severity.Info" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.CreditCard" Class="mr-1" />
                        クレジットカード決済は安全な Stripe 決済ページにてお手続きいただきます。
                    </MudAlert>
                    <MudRadioGroup @bind-Value="_paymentMethod">
                        <MudRadio T="string" Value="@("credit_card")" Color="Color.Primary">
                            クレジットカード（Stripe）
                        </MudRadio>
                    </MudRadioGroup>
                </MudPaper>

                @* Point usage (M-05) *@
                @if (_pointBalance > 0)
                {
                    <MudPaper Elevation="2" Class="pa-6" Style="border-radius: 12px;">
                        <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight: 600;">ポイント使用</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            保有ポイント: <strong>@_pointBalance.ToString("N0") pt</strong>（1pt = 1円）
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                            使用上限: 合計金額の 50%（最大 @_maxPointsUsable.ToString("N0") pt）
                        </MudText>

                        <MudSlider @bind-Value="_pointsToUse" Min="0" Max="@_maxPointsUsable" Step="1"
                                   Color="Color.Primary" Class="mb-2">
                            使用ポイント: @_pointsToUse pt
                        </MudSlider>

                        <div style="display: flex; gap: 8px; align-items: center;">
                            <MudNumericField @bind-Value="_pointsToUse" Min="0" Max="@_maxPointsUsable"
                                             Label="使用ポイント" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Style="max-width: 150px;" />
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       OnClick="@(() => _pointsToUse = _maxPointsUsable)">
                                全額使う
                            </MudButton>
                        </div>

                        @if (_pointValidationError is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error" Class="mt-1">@_pointValidationError</MudText>
                        }
                    </MudPaper>
                }
            </MudItem>

            <MudItem xs="12" md="4">
                @* Summary *@
                <MudPaper Elevation="2" Class="pa-4" Style="border-radius: 12px;">
                    <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 600;">注文サマリー</MudText>
                    <div class="summary-row"><span>小計（税抜）</span><span>¥@_cart.Subtotal.ToString("N0")</span></div>
                    <div class="summary-row"><span>消費税（10%）</span><span>¥@_cart.Tax.ToString("N0")</span></div>
                    <div class="summary-row"><span>送料</span><span>@(_cart.ShippingFee == 0 ? "無料" : $"¥{_cart.ShippingFee:N0}")</span></div>
                    @if (_cart.CouponDiscount > 0)
                    {
                        <div class="summary-row" style="color: #d32f2f;"><span>クーポン割引</span><span>-¥@_cart.CouponDiscount.ToString("N0")</span></div>
                    }
                    @if (_pointsToUse > 0)
                    {
                        <div class="summary-row" style="color: #d32f2f;"><span>ポイント使用</span><span>-@_pointsToUse pt</span></div>
                    }
                    <MudDivider Class="my-3" />
                    <div class="summary-row total"><span>合計（税込）</span><span>¥@((_cart.Total - _pointsToUse).ToString("N0"))</span></div>
                    @if (_cart.EarnablePoints > 0)
                    {
                        <div class="summary-row points"><span>獲得予定ポイント</span><span>@_cart.EarnablePoints pt</span></div>
                    }

                    <div style="display: flex; justify-content: space-between; margin-top: 1.5rem;">
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   OnClick="@(() => Navigation.NavigateTo("/checkout/shipping"))"
                                   StartIcon="@Icons.Material.Filled.ArrowBack">
                            戻る
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="ProceedToConfirm"
                                   Disabled="@(!ValidatePoints())"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            注文確認へ
                        </MudButton>
                    </div>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

<style>
    .summary-row { display: flex; justify-content: space-between; padding: 4px 0; font-size: 0.95rem; }
    .summary-row.total { font-weight: 700; font-size: 1.2rem; color: #0D47A1; }
    .summary-row.points { color: #f57c00; font-size: 0.9rem; }
</style>

@code {
    private CartDto? _cart;
    private bool _isLoading = true;
    private string _paymentMethod = "credit_card";
    private int _pointBalance;
    private int _maxPointsUsable;
    private int _pointsToUse;
    private string? _pointValidationError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _cart = await CartApi.GetCartAsync();

            try
            {
                var balance = await PointApi.GetBalanceAsync();
                _pointBalance = balance?.AvailablePoints ?? 0;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "ポイント残高取得失敗（デフォルト0で継続）");
                _pointBalance = 0;
            }

            if (_cart is not null)
            {
                _maxPointsUsable = (int)Math.Min(_pointBalance, _cart.Total * 0.5m);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "支払い画面読み込みエラー");
            Snackbar.Add("データの読み込みに失敗しました", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool ValidatePoints()
    {
        _pointValidationError = null;
        if (_pointsToUse < 0)
        {
            _pointValidationError = "ポイントは 0 以上を入力してください";
            return false;
        }
        if (_pointsToUse > _pointBalance)
        {
            _pointValidationError = "保有ポイントを超えています";
            return false;
        }
        if (_pointsToUse > _maxPointsUsable)
        {
            _pointValidationError = $"使用上限は {_maxPointsUsable:N0} pt です";
            return false;
        }
        return true;
    }

    private void ProceedToConfirm()
    {
        if (ValidatePoints())
        {
            Navigation.NavigateTo("/checkout/confirm");
        }
    }
}
