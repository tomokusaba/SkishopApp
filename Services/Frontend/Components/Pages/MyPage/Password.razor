@page "/mypage/password"
@rendermode @(RenderMode.InteractiveServer)
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject Frontend.Services.Interfaces.IApiGatewayClient ApiClient
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ILogger<Frontend.Components.Pages.MyPage.Password> Logger

<PageTitle>パスワード変更 — Azure SkiShop</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/mypage" Class="mb-4">
        マイページに戻る
    </MudButton>

    <MudPaper Elevation="4" Class="pa-8 rounded-lg">
        <div class="text-center mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" Size="Size.Large" />
            <MudText Typo="Typo.h4" Class="mt-2" Style="font-weight: 700; color: #1565C0;">
                パスワード変更
            </MudText>
        </div>

        <MudForm @ref="_form" @bind-IsValid="_isFormValid">
            <MudTextField @bind-Value="_currentPassword"
                          Label="現在のパスワード"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="現在のパスワードは必須です"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          autocomplete="current-password" />

            <MudTextField @bind-Value="_newPassword"
                          Label="新しいパスワード"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="新しいパスワードは必須です"
                          Validation="@(new Func<string, string?>(ValidateNewPassword))"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          autocomplete="new-password" />

            <MudTextField @bind-Value="_confirmPassword"
                          Label="新しいパスワード（確認）"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="パスワード確認は必須です"
                          Validation="@(new Func<string, string?>(ValidateConfirmPassword))"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          autocomplete="new-password" />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_errorMessage</MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="HandleChangePasswordAsync"
                       Disabled="@(!_isFormValid || _isSaving)"
                       Style="min-height: 48px;">
                @if (_isSaving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                パスワードを変更する
            </MudButton>
        </MudForm>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? _form;
    private bool _isFormValid;
    private bool _isSaving;
    private string? _errorMessage;

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;

    private string? ValidateNewPassword(string password)
    {
        if (string.IsNullOrEmpty(password))
            return "新しいパスワードは必須です";
        if (password.Length < 8)
            return "パスワードは8文字以上で入力してください";
        return null;
    }

    private string? ValidateConfirmPassword(string confirmPassword)
    {
        if (string.IsNullOrEmpty(confirmPassword))
            return "パスワード確認は必須です";
        if (confirmPassword != _newPassword)
            return "パスワードが一致しません";
        return null;
    }

    private async Task HandleChangePasswordAsync()
    {
        if (_form is not null) await _form.Validate();
        if (!_isFormValid) return;

        _isSaving = true;
        _errorMessage = null;

        try
        {
            var request = new ChangePasswordRequest(_currentPassword, _newPassword);
            await ApiClient.PostAsync<ChangePasswordRequest, object>("/api/v1/auth/change-password", request);
            Snackbar.Add("パスワードを変更しました", Severity.Success);
            Navigation.NavigateTo("/mypage");
        }
        catch (UnauthorizedAccessException)
        {
            _errorMessage = "現在のパスワードが正しくありません";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "パスワード変更に失敗: {Message}", ex.Message);
            _errorMessage = "パスワードの変更に失敗しました";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private record ChangePasswordRequest(string CurrentPassword, string NewPassword);
}
