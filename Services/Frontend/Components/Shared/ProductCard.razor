@using Frontend.Services

<MudCard Class="product-card" Elevation="2" Style="height: 100%; display: flex; flex-direction: column;">
    <MudCardMedia Image="@PrimaryImageUrl"
                  Height="220"
                  Style="object-fit: contain; background: #f5f5f5;" />
    <MudCardContent Style="flex: 1; display: flex; flex-direction: column;">
        <MudText Typo="Typo.caption" Color="Color.Primary" Class="mb-1">@Product.CategoryName</MudText>
        <MudLink Href="@($"/products/{Product.Id}")" Underline="Underline.None" Color="Color.Inherit">
            <MudText Typo="Typo.subtitle1" Class="product-card-title mb-2"
                     Style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 3rem;">
                @Product.Name
            </MudText>
        </MudLink>
        <div style="flex: 1;"></div>

        @if (Product.AverageRating > 0)
        {
            <div class="d-flex align-center gap-1 mb-1">
                <MudRating ReadOnly="true" SelectedValue="@((int)Math.Round(Product.AverageRating))" Size="Size.Small" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">(@Product.ReviewCount)</MudText>
            </div>
        }

        <div class="d-flex align-center gap-2 mb-1">
            @if (Product.OriginalPrice.HasValue && Product.OriginalPrice.Value > Product.Price)
            {
                <MudText Typo="Typo.body2" Style="text-decoration: line-through; color: #999;">
                    ¥@Product.OriginalPrice.Value.ToString("N0")
                </MudText>
                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled"
                         Label="true" Class="px-1" Style="font-size: 0.7rem;">
                    @($"{(int)((1 - Product.Price / Product.OriginalPrice.Value) * 100)}% OFF")
                </MudChip>
            }
        </div>
        <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight: 700;">
            ¥@Product.Price.ToString("N0")
        </MudText>
        <div class="mt-1">
            <Frontend.Components.Shared.StockBadge StockQuantity="@Product.StockQuantity" />
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public ProductDto Product { get; set; } = default!;

    [Parameter]
    public bool LazyLoad { get; set; } = true;

    private string PrimaryImageUrl =>
        Product.ImageUrls is { Count: > 0 } urls ? urls[0] : "/images/no-image.webp";
}
