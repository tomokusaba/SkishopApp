@page
@model AdminPortal.Pages.Admin.Mails.IndexModel
@{
    ViewData["Title"] = "メール管理";
    Layout = "/Pages/Admin/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-envelope"></i> メール管理</h1>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "templates" ? "active" : "")"
               asp-page="/Admin/Mails/Index" asp-route-activeTab="templates">テンプレート管理</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "test" ? "active" : "")"
               asp-page="/Admin/Mails/Index" asp-route-activeTab="test">テスト送信</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "logs" ? "active" : "")"
               asp-page="/Admin/Mails/Index" asp-route-activeTab="logs">送信履歴</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "stats" ? "active" : "")"
               asp-page="/Admin/Mails/Index" asp-route-activeTab="stats">統計</a>
        </li>
    </ul>

    @if (Model.ActiveTab == "templates")
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">新規テンプレート作成</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="CreateTemplate">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">テンプレート名</label>
                            <input type="text" class="form-control" asp-for="TemplateForm.Name" required maxlength="100" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">件名</label>
                            <input type="text" class="form-control" asp-for="TemplateForm.Subject" required maxlength="200" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">本文</label>
                            <textarea class="form-control" asp-for="TemplateForm.Body" rows="5" required></textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> 作成
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">テンプレート一覧</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>テンプレート名</th>
                                <th>件名</th>
                                <th>プレビュー</th>
                                <th>作成日</th>
                                <th>更新日</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Templates.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">テンプレートがありません。</td>
                                </tr>
                            }
                            @foreach (var template in Model.Templates)
                            {
                                <tr>
                                    <td><strong>@template.Name</strong></td>
                                    <td>@template.Subject</td>
                                    <td><small class="text-muted">@template.BodyPreview</small></td>
                                    <td>@template.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    <td>@template.UpdatedAt.ToString("yyyy/MM/dd")</td>
                                    <td>
                                        <form method="post" asp-page-handler="DeleteTemplate" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="templateId" value="@template.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('このテンプレートを削除しますか？')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "test")
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">テスト送信</h5>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="TestSend">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">テンプレート選択</label>
                            <select class="form-select" asp-for="TestSend.TemplateId" required>
                                <option value="">-- テンプレートを選択 --</option>
                                @foreach (var template in Model.Templates)
                                {
                                    <option value="@template.Id">@template.Name (@template.Subject)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">送信先メールアドレス</label>
                            <input type="email" class="form-control" asp-for="TestSend.RecipientEmail"
                                   required maxlength="255" placeholder="test@example.com" />
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary"
                                    onclick="return confirm('テストメールを送信しますか？')">
                                <i class="bi bi-send"></i> テスト送信
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
    else if (Model.ActiveTab == "logs")
    {
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">送信履歴</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>送信日時</th>
                                <th>テンプレート</th>
                                <th>宛先</th>
                                <th>件名</th>
                                <th>ステータス</th>
                                <th>エラー</th>
                                <th>操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MailLogs.Count == 0)
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">送信履歴がありません。</td>
                                </tr>
                            }
                            @foreach (var log in Model.MailLogs)
                            {
                                <tr>
                                    <td>@log.SentAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>@log.TemplateName</td>
                                    <td>@log.RecipientEmail</td>
                                    <td>@log.Subject</td>
                                    <td>
                                        <span class="badge bg-@(log.Status == "delivered" ? "success" : log.Status == "failed" ? "danger" : "warning")">
                                            @(log.Status == "delivered" ? "配信済" : log.Status == "failed" ? "失敗" : "送信中")
                                        </span>
                                    </td>
                                    <td><small class="text-danger">@(log.ErrorMessage ?? "—")</small></td>
                                    <td>
                                        <form method="post" asp-page-handler="Resend" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="logId" value="@log.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="再送">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="ページナビゲーション">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="/Admin/Mails/Index"
                                   asp-route-activeTab="logs" asp-route-currentPage="@(Model.CurrentPage - 1)">前へ</a>
                            </li>
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-page="/Admin/Mails/Index"
                                       asp-route-activeTab="logs" asp-route-currentPage="@i">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-page="/Admin/Mails/Index"
                                   asp-route-activeTab="logs" asp-route-currentPage="@(Model.CurrentPage + 1)">次へ</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
    else if (Model.ActiveTab == "stats")
    {
        @if (Model.Stats is not null)
        {
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="card text-white bg-success">
                        <div class="card-body text-center">
                            <h6 class="card-title">送信成功率</h6>
                            <h2>@Model.Stats.SuccessRate.ToString("P1")</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-primary">
                        <div class="card-body text-center">
                            <h6 class="card-title">配信率</h6>
                            <h2>@Model.Stats.DeliveryRate.ToString("P1")</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-info">
                        <div class="card-body text-center">
                            <h6 class="card-title">送信総数</h6>
                            <h2>@Model.Stats.TotalSent</h2>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-danger">
                        <div class="card-body text-center">
                            <h6 class="card-title">失敗数</h6>
                            <h2>@Model.Stats.TotalFailed</h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">送信推移</h5>
                </div>
                <div class="card-body">
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-graph-up" style="font-size: 3rem;"></i>
                        <p class="mt-2">チャートは将来のバージョンで実装予定です。</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning">メール統計の取得に失敗しました。</div>
        }
    }
</div>
