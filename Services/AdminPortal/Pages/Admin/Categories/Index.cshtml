@page
@model AdminPortal.Pages.Admin.Categories.IndexModel
@{
    ViewData["Title"] = "カテゴリ管理";
    Layout = "/Pages/Admin/_Layout.cshtml";
}

<h2 class="mb-4">カテゴリ管理</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
}

<div class="row">
    <div class="col-md-4">
        <div class="card bg-dark border-secondary mb-4">
            <div class="card-header">新規カテゴリ作成</div>
            <div class="card-body">
                <form method="post" asp-page-handler="Create">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="newCategoryName" class="form-label">カテゴリ名 <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="newCategoryName" asp-for="NewCategoryName"
                               required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="newCategoryDescription" class="form-label">説明</label>
                        <textarea class="form-control" id="newCategoryDescription" asp-for="NewCategoryDescription"
                                  rows="2" maxlength="500"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">作成</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover">
                <thead>
                    <tr>
                        <th>カテゴリ名</th>
                        <th>説明</th>
                        <th class="text-end">商品数</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Categories.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-secondary py-4">カテゴリがありません</td></tr>
                    }
                    @foreach (var category in Model.Categories)
                    {
                        <tr>
                            <td>@category.Name</td>
                            <td class="text-secondary">@(category.Description ?? "-")</td>
                            <td class="text-end">@category.ProductCount</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                        data-bs-toggle="modal" data-bs-target="#editModal-@category.Id">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form method="post" asp-page-handler="Delete" class="d-inline"
                                      onsubmit="return confirm('このカテゴリを削除しますか？');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="categoryId" value="@category.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>

                        <div class="modal fade" id="editModal-@category.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content bg-dark border-secondary">
                                    <form method="post" asp-page-handler="Edit">
                                        @Html.AntiForgeryToken()
                                        <div class="modal-header border-secondary">
                                            <h5 class="modal-title">カテゴリ編集</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="閉じる"></button>
                                        </div>
                                        <div class="modal-body">
                                            <input type="hidden" name="EditCategoryId" value="@category.Id" />
                                            <div class="mb-3">
                                                <label class="form-label">カテゴリ名</label>
                                                <input type="text" class="form-control" name="EditCategoryName"
                                                       value="@category.Name" required maxlength="100" />
                                            </div>
                                        </div>
                                        <div class="modal-footer border-secondary">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">キャンセル</button>
                                            <button type="submit" class="btn btn-primary">更新</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
