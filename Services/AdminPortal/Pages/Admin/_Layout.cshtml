<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SkiShop 管理</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" />
</head>
<body class="admin-body">
    <div class="admin-wrapper d-flex">
        <nav class="admin-sidebar" role="navigation" aria-label="管理メニュー">
            <div class="sidebar-header p-3">
                <a href="/Admin" class="text-decoration-none">
                    <h5 class="text-white mb-0"><i class="bi bi-snow2"></i> SkiShop 管理</h5>
                </a>
            </div>
            <hr class="text-secondary mx-3 my-0" />
            <ul class="nav flex-column p-2">
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin"><i class="bi bi-speedometer2 me-2"></i>ダッシュボード</a>
                </li>
                <li class="nav-item mt-2"><small class="text-secondary px-3">商品</small></li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Products"><i class="bi bi-box-seam me-2"></i>商品管理</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Products/Create"><i class="bi bi-plus-circle me-2"></i>商品登録</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Categories"><i class="bi bi-tags me-2"></i>カテゴリ管理</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Inventory"><i class="bi bi-clipboard-data me-2"></i>在庫管理</a>
                </li>
                <li class="nav-item mt-2"><small class="text-secondary px-3">販売</small></li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Orders"><i class="bi bi-receipt me-2"></i>注文管理</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Shipments"><i class="bi bi-truck me-2"></i>配送管理</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Returns"><i class="bi bi-arrow-return-left me-2"></i>返品管理</a>
                </li>
                <li class="nav-item mt-2"><small class="text-secondary px-3">プロモーション</small></li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Coupons"><i class="bi bi-ticket-perforated me-2"></i>クーポン管理</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Points"><i class="bi bi-star me-2"></i>ポイント管理</a>
                </li>
                <li class="nav-item mt-2"><small class="text-secondary px-3">ユーザー</small></li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Users"><i class="bi bi-people me-2"></i>ユーザー管理</a>
                </li>
                <li class="nav-item mt-2"><small class="text-secondary px-3">システム</small></li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Mail"><i class="bi bi-envelope me-2"></i>メール管理</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/Reports"><i class="bi bi-graph-up me-2"></i>レポート</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/SecurityLogs"><i class="bi bi-shield-lock me-2"></i>セキュリティログ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="/Admin/AiSupport"><i class="bi bi-robot me-2"></i>AI サポート</a>
                </li>
            </ul>
        </nav>

        <div class="admin-content flex-grow-1 d-flex flex-column">
            <header class="admin-topbar d-flex align-items-center justify-content-between px-4 py-2" role="banner">
                <div>
                    <span class="text-light fw-semibold">@ViewData["Title"]</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-light"><i class="bi bi-person-circle me-1"></i>@User.Identity.Name</span>
                        <form method="post" asp-page="/Admin/Logout" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i>ログアウト
                            </button>
                        </form>
                    }
                </div>
            </header>

            <main class="p-4 flex-grow-1 overflow-auto" role="main">
                @RenderBody()
            </main>

            <footer class="admin-footer text-center text-secondary py-2" role="contentinfo">
                <small>&copy; 2025 SkiShop Admin Portal</small>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
