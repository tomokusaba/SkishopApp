@page
@model LoginModel
@{
    ViewData["Title"] = "管理者ログイン";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SkiShop 管理者ログイン</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <style>
        body { background-color: #1a1d23; color: #e0e0e0; min-height: 100vh; display: flex; align-items: center; }
        .login-card { max-width: 420px; background-color: #12151a; border: 1px solid #2d3139; }
        .form-control { background-color: #1e2127; border-color: #2d3139; color: #e0e0e0; }
        .form-control:focus { background-color: #23272e; border-color: #0d6efd; color: #e0e0e0; box-shadow: 0 0 0 0.2rem rgba(13,110,253,.25); }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card login-card shadow-lg rounded-3">
                    <div class="card-body p-5">
                        <h3 class="text-center mb-4 text-white">SkiShop 管理者ログイン</h3>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
                        }

                        <form method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="email" class="form-label">メールアドレス</label>
                                <input type="email" class="form-control" id="email" asp-for="Email"
                                       placeholder="admin@example.com" required autocomplete="email" />
                            </div>
                            <div class="mb-4">
                                <label for="password" class="form-label">パスワード</label>
                                <input type="password" class="form-control" id="password" asp-for="Password"
                                       required autocomplete="current-password" />
                            </div>
                            <button type="submit" class="btn btn-primary w-100">ログイン</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
