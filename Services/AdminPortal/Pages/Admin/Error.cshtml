@page
@model AdminPortal.Pages.Admin.ErrorModel
@{
    ViewData["Title"] = "エラー";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 text-danger">
                <i class="bi bi-exclamation-triangle"></i>
            </h1>
            <h2 class="mb-3">エラーが発生しました</h2>
            <p class="text-muted mb-4">
                申し訳ございません。予期しないエラーが発生しました。<br />
                しばらく経ってから再度お試しください。
            </p>

            @if (!string.IsNullOrEmpty(Model.RequestId))
            {
                <p class="text-muted small">
                    <strong>リクエスト ID:</strong> @Model.RequestId
                </p>
            }

            <a href="/Admin" class="btn btn-primary mt-3">
                <i class="bi bi-house"></i> ダッシュボードに戻る
            </a>
        </div>
    </div>
</div>
