@page
@model AdminPortal.Pages.Admin.Ai.Models.IndexModel
@{
    ViewData["Title"] = "AI モデル管理";
    Layout = "/Pages/Admin/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-cpu"></i> AI モデル管理</h1>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @Model.StatusMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>モデル名</th>
                            <th>タイプ</th>
                            <th>バージョン</th>
                            <th>ステータス</th>
                            <th>精度</th>
                            <th>作成日</th>
                            <th>最終トレーニング</th>
                            @if (Model.IsAdmin)
                            {
                                <th>操作</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Models.Count == 0)
                        {
                            <tr>
                                <td colspan="@(Model.IsAdmin ? 8 : 7)" class="text-center text-muted py-4">
                                    モデルがありません。
                                </td>
                            </tr>
                        }
                        @foreach (var aiModel in Model.Models)
                        {
                            <tr>
                                <td><strong>@aiModel.Name</strong></td>
                                <td>@aiModel.Type</td>
                                <td><code>@aiModel.Version</code></td>
                                <td>
                                    @{
                                        var statusClass = aiModel.Status switch
                                        {
                                            "active" => "success",
                                            "training" => "warning",
                                            "inactive" => "secondary",
                                            "failed" => "danger",
                                            _ => "light"
                                        };
                                        var statusLabel = aiModel.Status switch
                                        {
                                            "active" => "稼働中",
                                            "training" => "トレーニング中",
                                            "inactive" => "非アクティブ",
                                            "failed" => "失敗",
                                            _ => aiModel.Status
                                        };
                                    }
                                    <span class="badge bg-@statusClass">@statusLabel</span>
                                </td>
                                <td>
                                    @if (aiModel.Accuracy.HasValue)
                                    {
                                        var accClass = aiModel.Accuracy.Value >= 0.9m ? "success"
                                            : aiModel.Accuracy.Value >= 0.7m ? "warning" : "danger";
                                        <span class="badge bg-@accClass">@aiModel.Accuracy.Value.ToString("P1")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@aiModel.CreatedAt.ToString("yyyy/MM/dd")</td>
                                <td>@(aiModel.LastTrainedAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</td>
                                @if (Model.IsAdmin)
                                {
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <form method="post" asp-page-handler="Train" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="modelId" value="@aiModel.Id" />
                                                <button type="submit" class="btn btn-outline-primary" title="トレーニング開始"
                                                        onclick="return confirm('このモデルのトレーニングを開始しますか？')"
                                                        disabled="@(aiModel.Status == "training")">
                                                    <i class="bi bi-play-circle"></i>
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete" class="d-inline ms-1">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="modelId" value="@aiModel.Id" />
                                                <button type="submit" class="btn btn-outline-danger" title="削除"
                                                        onclick="return confirm('このモデルを削除しますか？この操作は取り消せません。')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="ページナビゲーション">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="/Admin/Ai/Models/Index"
                               asp-route-currentPage="@(Model.CurrentPage - 1)">前へ</a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="/Admin/Ai/Models/Index"
                                   asp-route-currentPage="@i">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-page="/Admin/Ai/Models/Index"
                               asp-route-currentPage="@(Model.CurrentPage + 1)">次へ</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
