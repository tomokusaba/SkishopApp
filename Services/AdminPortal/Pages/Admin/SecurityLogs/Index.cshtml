@page
@model AdminPortal.Pages.Admin.SecurityLogs.IndexModel
@{
    ViewData["Title"] = "セキュリティログ";
    Layout = "/Pages/Admin/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-shield-lock"></i> セキュリティログ</h1>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">イベントタイプ</label>
                    <select name="EventTypeFilter" class="form-select">
                        <option value="">すべて</option>
                        @foreach (var eventType in AdminPortal.Pages.Admin.SecurityLogs.IndexModel.EventTypes)
                        {
                            <option value="@eventType" selected="@(Model.EventTypeFilter == eventType)">@eventType</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">ユーザー</label>
                    <input type="text" class="form-control" name="UserFilter" value="@Model.UserFilter"
                           placeholder="ユーザーID/メール" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">開始日</label>
                    <input type="date" class="form-control" name="StartDate"
                           value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">終了日</label>
                    <input type="date" class="form-control" name="EndDate"
                           value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary">フィルタ適用</button>
                    <a asp-page="/Admin/SecurityLogs/Index" class="btn btn-outline-secondary">リセット</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>日時</th>
                            <th>イベントタイプ</th>
                            <th>ユーザー</th>
                            <th>IPアドレス</th>
                            <th>詳細</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Logs.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">ログが見つかりません。</td>
                            </tr>
                        }
                        @foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td>@log.OccurredAt.ToString("yyyy/MM/dd HH:mm:ss")</td>
                                <td>
                                    @{
                                        var eventClass = log.EventType switch
                                        {
                                            "LOGIN_SUCCESS" => "success",
                                            "LOGIN_FAILURE" => "danger",
                                            "LOGOUT" => "info",
                                            "PASSWORD_CHANGE" => "warning",
                                            "ROLE_CHANGE" => "primary",
                                            "ACCOUNT_LOCKED" => "danger",
                                            "ACCOUNT_UNLOCKED" => "success",
                                            "ACCESS_DENIED" => "danger",
                                            _ => "secondary"
                                        };
                                    }
                                    <span class="badge bg-@eventClass">@log.EventType</span>
                                </td>
                                <td>
                                    <small class="text-muted">@log.UserId</small><br />
                                    @log.UserEmail
                                </td>
                                <td><code>@log.IpAddress</code></td>
                                <td>@(log.Details ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="ページナビゲーション">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="/Admin/SecurityLogs/Index"
                               asp-route-currentPage="@(Model.CurrentPage - 1)"
                               asp-route-eventTypeFilter="@Model.EventTypeFilter"
                               asp-route-userFilter="@Model.UserFilter"
                               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">前へ</a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-page="/Admin/SecurityLogs/Index"
                                   asp-route-currentPage="@i"
                                   asp-route-eventTypeFilter="@Model.EventTypeFilter"
                                   asp-route-userFilter="@Model.UserFilter"
                                   asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                                   asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-page="/Admin/SecurityLogs/Index"
                               asp-route-currentPage="@(Model.CurrentPage + 1)"
                               asp-route-eventTypeFilter="@Model.EventTypeFilter"
                               asp-route-userFilter="@Model.UserFilter"
                               asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
                               asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")">次へ</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
