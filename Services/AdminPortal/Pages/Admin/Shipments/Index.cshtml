@page
@model AdminPortal.Pages.Admin.Shipments.IndexModel
@{
    ViewData["Title"] = "配送管理";
    Layout = "/Pages/Admin/_Layout.cshtml";
}

<h2 class="mb-4">配送管理</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" role="alert">@Model.SuccessMessage</div>
}

<div class="card bg-dark border-secondary mb-4">
    <div class="card-header">新規配送作成</div>
    <div class="card-body">
        <form method="post" asp-page-handler="Create" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label">注文ID <span class="text-danger">*</span></label>
                <input type="text" class="form-control" asp-for="CreateOrderId" required maxlength="36" />
            </div>
            <div class="col-md-3">
                <label class="form-label">配送業者 <span class="text-danger">*</span></label>
                <select class="form-select" asp-for="CreateCarrier" required>
                    <option value="">-- 選択 --</option>
                    <option value="Yamato">ヤマト運輸</option>
                    <option value="Sagawa">佐川急便</option>
                    <option value="JapanPost">日本郵便</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">追跡番号</label>
                <input type="text" class="form-control" asp-for="CreateTrackingNumber" maxlength="50" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">作成</button>
            </div>
        </form>
    </div>
</div>

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-md-2">
        <label class="form-label">ステータス</label>
        <select class="form-select" name="status">
            <option value="">すべて</option>
            <option value="Preparing" selected="@(Model.StatusFilter == "Preparing")">準備中</option>
            <option value="Shipped" selected="@(Model.StatusFilter == "Shipped")">発送済</option>
            <option value="InTransit" selected="@(Model.StatusFilter == "InTransit")">配送中</option>
            <option value="Delivered" selected="@(Model.StatusFilter == "Delivered")">配達完了</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i>フィルター</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-dark table-striped table-hover">
        <thead>
            <tr>
                <th>配送ID</th>
                <th>注文ID</th>
                <th>配送業者</th>
                <th>追跡番号</th>
                <th>ステータス</th>
                <th>作成日</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Shipments.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-secondary py-4">配送データがありません</td></tr>
            }
            @foreach (var shipment in Model.Shipments)
            {
                <tr>
                    <td><code>@shipment.Id[..Math.Min(8, shipment.Id.Length)]</code></td>
                    <td><code>@shipment.OrderId[..Math.Min(8, shipment.OrderId.Length)]</code></td>
                    <td>@shipment.Carrier</td>
                    <td>@(shipment.TrackingNumber ?? "-")</td>
                    <td>
                        @{
                            var badgeClass = shipment.Status switch
                            {
                                "Preparing" => "bg-warning text-dark",
                                "Shipped" => "bg-info",
                                "InTransit" => "bg-primary",
                                "Delivered" => "bg-success",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@shipment.Status</span>
                    </td>
                    <td>@shipment.CreatedAt.ToString("yyyy/MM/dd")</td>
                    <td>
                        <div class="d-flex gap-1">
                            <form method="post" asp-page-handler="UpdateStatus" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="shipmentId" value="@shipment.Id" />
                                <select name="newStatus" class="form-select form-select-sm d-inline" style="width: auto"
                                        onchange="this.form.submit()">
                                    <option value="">更新</option>
                                    <option value="Preparing">準備中</option>
                                    <option value="Shipped">発送済</option>
                                    <option value="InTransit">配送中</option>
                                    <option value="Delivered">配達完了</option>
                                </select>
                            </form>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-bs-toggle="modal" data-bs-target="#trackingModal-@shipment.Id">
                                <i class="bi bi-hash"></i>
                            </button>
                        </div>

                        <div class="modal fade" id="trackingModal-@shipment.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content bg-dark border-secondary">
                                    <form method="post" asp-page-handler="UpdateTracking">
                                        @Html.AntiForgeryToken()
                                        <div class="modal-header border-secondary">
                                            <h5 class="modal-title">追跡番号更新</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="閉じる"></button>
                                        </div>
                                        <div class="modal-body">
                                            <input type="hidden" name="shipmentId" value="@shipment.Id" />
                                            <div class="mb-3">
                                                <label class="form-label">追跡番号</label>
                                                <input type="text" class="form-control" name="trackingNumber"
                                                       value="@shipment.TrackingNumber" required maxlength="50" />
                                            </div>
                                        </div>
                                        <div class="modal-footer border-secondary">
                                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">キャンセル</button>
                                            <button type="submit" class="btn btn-primary">更新</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="配送ページネーション">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" href="/Admin/Shipments?page=@(Model.CurrentPage - 1)&status=@Model.StatusFilter">&laquo;</a>
            </li>
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="/Admin/Shipments?page=@i&status=@Model.StatusFilter">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/Admin/Shipments?page=@(Model.CurrentPage + 1)&status=@Model.StatusFilter">&raquo;</a>
            </li>
        </ul>
    </nav>
}
